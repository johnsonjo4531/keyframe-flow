{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.json",
  "readme": "README.md",
  "disableSources": false,
  "sourceLinkTemplate": "https://github.com/johnsonjo4531/keyframe-flow/blob/{gitRevision}/{path}#L{line}",
  "validation": {
    "notDocumented": true,
    "invalidLink": true
  },
  "plugin": ["@clean-jsdoc-theme/typedoc"],
  "outputs": [{ "name": "clean-jsdoc-theme", "path": "site/docs" }],
  "cleanJsdocTheme": {
    "siteName": "keyframe-flow",
    "basePath": "/keyframe-flow/docs",
    "siteUrl": "https://johnsonjo4531.github.io",
    "docs": "docs",
    "docGroups": ["Getting Started", "Guides", "Project"],
    // llmstxt.org indexes (T61): llms.txt lists every page (guides + API,
    // with descriptions) linking its companion Markdown; llms-full.txt
    // concatenates all bodies. Requires siteUrl above; source-file pages are
    // never listed. https://johnsonjo4531.github.io/keyframe-flow/docs/llms.txt
    "llmsTxt": true,
    "menu": [
      { "id": "home", "title": "Home" },
      { "title": "Storybook", "link": "/keyframe-flow/storybook/", "icon": "lucide:play-circle" },
      // Vanilla-TypeScript examples gallery (T62): pinned on every docs page
      // like Storybook — same menu mechanism, absolute project-site path.
      {
        "title": "Vanilla TS",
        "link": "/keyframe-flow/examples/",
        "icon": "simple-icons:typescript"
      },
      {
        "title": "llms.txt",
        "link": "https://johnsonjo4531.github.io/keyframe-flow/docs/llms.txt",
        "icon": "lucide:bot"
      },
      {
        "title": "GitHub",
        "link": "https://github.com/johnsonjo4531/keyframe-flow",
        "icon": "simple-icons:github"
      }
    ],
    "strict": true
  }
}
